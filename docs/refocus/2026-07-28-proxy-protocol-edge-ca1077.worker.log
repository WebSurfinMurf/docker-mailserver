{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PKPCcrhkmNfpBYtZCZfj5J","type":"tool_result","content":"1\t# PROXY protocol (HAProxy v2) from the AWS mail edge - Dovecot side.\n2\t#\n3\t# Trust ONLY the edge's WireGuard tunnel address. A wider CIDR here would let any\n4\t# host that can reach 993 spoof its own source IP via a forged PROXY header.\n5\thaproxy_trusted_networks = 10.77.0.1/32\n6\thaproxy_timeout = 3 secs\n7\t\n8\t# Only 993 is proxied - that is the sole IMAP port the edge forwards. Port 143\n9\t# stays plain: it is bound inside the mail-edge-wg network namespace and is not\n10\t# published to the host or LAN, so nothing external can reach it.\n11\t#\n12\t# Enabling haproxy on a listener makes the PROXY header MANDATORY for every\n13\t# connection to it; 993 therefore serves edge traffic exclusively.\n14\tservice imap-login {\n15\t  inet_listener imaps {\n16\t    haproxy = yes\n17\t  }\n18\t}\n19\t"}]},"parent_tool_use_id":null,"session_id":"4887fea5-78a1-4b14-a071-ae362ca71a13","uuid":"86009d9b-9725-4675-a22f-d14423b3cd65","timestamp":"2026-07-28T13:53:19.998Z","tool_use_result":{"type":"text","file":{"filePath":"/home/administrator/projects/docker-mailserver/config/dovecot.cf","content":"# PROXY protocol (HAProxy v2) from the AWS mail edge - Dovecot side.\n#\n# Trust ONLY the edge's WireGuard tunnel address. A wider CIDR here would let any\n# host that can reach 993 spoof its own source IP via a forged PROXY header.\nhaproxy_trusted_networks = 10.77.0.1/32\nhaproxy_timeout = 3 secs\n\n# Only 993 is proxied - that is the sole IMAP port the edge forwards. Port 143\n# stays plain: it is bound inside the mail-edge-wg network namespace and is not\n# published to the host or LAN, so nothing external can reach it.\n#\n# Enabling haproxy on a listener makes the PROXY header MANDATORY for every\n# connection to it; 993 therefore serves edge traffic exclusively.\nservice imap-login {\n  inet_listener imaps {\n    haproxy = yes\n  }\n}\n","numLines":19,"startLine":1,"totalLines":19}}}
